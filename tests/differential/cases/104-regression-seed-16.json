{
  "name": "fuzz-16",
  "initialVars": {
    "a": {
      "value": "x",
      "type": "any"
    },
    "b": {
      "value": 0,
      "type": "any"
    },
    "c": {
      "value": "x",
      "type": "any"
    },
    "d": {
      "value": 1,
      "type": "any"
    }
  },
  "actions": [
    {
      "type": "setVariable",
      "variableName": "d",
      "value": {
        "function": "getVariable",
        "variableName": "a"
      }
    },
    {
      "type": "repeat",
      "count": 0,
      "actions": [
        {
          "type": "decreaseVariableByNumber",
          "variableName": "c",
          "number": {
            "function": "concat",
            "textA": "5",
            "textB": {
              "function": "concat",
              "textA": 0.5,
              "textB": 10
            }
          }
        }
      ]
    },
    {
      "type": "condition",
      "conditions": {
        "operator": ">",
        "operandA": {
          "function": "concat",
          "textA": {
            "function": "calculate",
            "items": [
              {
                "operator": "+"
              },
              -2.5,
              100
            ]
          },
          "textB": {
            "function": "calculate",
            "items": [
              {
                "operator": "/"
              },
              "5",
              "5abc"
            ]
          }
        },
        "operandB": "hello"
      },
      "then": [
        {
          "type": "condition",
          "conditions": {
            "operator": "!=",
            "operandA": "hello",
            "operandB": {
              "function": "concat",
              "textA": 2,
              "textB": -1
            }
          },
          "then": [
            {
              "type": "increaseVariableByNumber",
              "variableName": "c",
              "number": 2
            },
            {
              "type": "decreaseVariableByNumber",
              "variableName": "b",
              "number": {
                "function": "calculate",
                "items": [
                  {
                    "operator": "%"
                  },
                  1,
                  ""
                ]
              }
            }
          ],
          "else": [
            {
              "type": "decreaseVariableByNumber",
              "variableName": "b",
              "number": {
                "function": "concat",
                "textA": "",
                "textB": "hello"
              }
            },
            {
              "type": "increaseVariableByNumber",
              "variableName": "c",
              "number": {
                "function": "calculate",
                "items": [
                  {
                    "operator": "-"
                  },
                  "5",
                  "x"
                ]
              }
            }
          ]
        },
        {
          "type": "repeat",
          "count": 4,
          "actions": [
            {
              "type": "increaseVariableByNumber",
              "variableName": "c",
              "number": {
                "function": "calculate",
                "items": [
                  {
                    "operator": "%"
                  },
                  0.5,
                  {
                    "function": "getVariable",
                    "variableName": "b"
                  }
                ]
              }
            }
          ]
        }
      ],
      "else": []
    },
    {
      "type": "setVariable",
      "variableName": "d",
      "value": 2
    }
  ]
}