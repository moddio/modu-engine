{
  "name": "fuzz-50",
  "initialVars": {
    "a": {
      "value": "",
      "type": "any"
    },
    "b": {
      "value": 0,
      "type": "any"
    },
    "c": {
      "value": 1,
      "type": "any"
    },
    "d": {
      "value": 0,
      "type": "any"
    }
  },
  "actions": [
    {
      "type": "repeat",
      "count": 1,
      "actions": [
        {
          "type": "increaseVariableByNumber",
          "variableName": "a",
          "number": 1
